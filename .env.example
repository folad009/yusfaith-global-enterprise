DATABASE_URL="postgresql://USER@localhost:5432/yusfaith"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# Clerk. Leave blank until a Clerk application exists.
# Portal routes refuse records and changes while these are empty.
# Roles are stored on UserProfile, not in Clerk profile fields. See docs/authentication.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/portal"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/portal"

# Development only. Ignored when NODE_ENV is production, even if set to true.
# Lets the portal read seeded records when Clerk keys are absent. It does not run in production.
PORTAL_ALLOW_DEMO_DATA=""
